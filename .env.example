# Supabase (required — app crashes if missing, no defaults)
# Local dev: run `supabase status -o env` to get these values
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OpenAI (required — app crashes if missing, no defaults)
# Used by the LLM evaluator to score refactored design-pattern solutions
OPENAI_API_KEY=

# Sentry (required for build/monitoring — app crashes if missing, no defaults)
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=